{
  "name": "gmrlog",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "GMRLOG — premium gaming social platform monorepo (Release Candidate v1.0)",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\"",
    "docker:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infrastructure/docker/docker-compose.yml down",
    "docker:prod:init": "node scripts/docker/init-prod-env.mjs",
    "docker:prod:preflight": "node scripts/docker/preflight-prod-env.mjs",
    "docker:prod:up": "node scripts/docker/preflight-prod-env.mjs && docker compose -f infrastructure/docker/docker-compose.yml -f infrastructure/docker/docker-compose.prod.yml --env-file infrastructure/docker/.env.production.local up -d --build",
    "docker:prod:down": "docker compose -f infrastructure/docker/docker-compose.yml -f infrastructure/docker/docker-compose.prod.yml down",
    "db:backup": "sh infrastructure/docker/scripts/backup-postgres.sh",
    "db:restore": "sh infrastructure/docker/scripts/restore-postgres.sh",
    "db:migrate:deploy": "node scripts/db-migrate-deploy.mjs",
    "fixture": "node scripts/dev/fixture.mjs",
    "db:validate:pg": "pnpm --filter @gmrlog/database run test:pg",
    "repair:index": "pnpm --filter @gmrlog/backend run repair:index",
    "release:smoke": "node scripts/release/smoke-infra.mjs && node scripts/release/smoke-health.mjs && node scripts/release/smoke-upload.mjs && node scripts/release/smoke-password.mjs && node scripts/release/smoke-search.mjs && node scripts/release/smoke-queue.mjs && node scripts/release/smoke-security.mjs",
    "release:smoke:full": "powershell -ExecutionPolicy Bypass -File scripts/release/smoke.ps1",
    "release:perf": "node scripts/release/smoke-perf.mjs",
    "release:backup": "node scripts/release/smoke-backup.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/js": "^9.22.0",
    "@gmrlog/eslint-config": "workspace:*",
    "@gmrlog/prettier-config": "workspace:*",
    "@gmrlog/typescript-config": "workspace:*",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-import": "^2.31.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "turbo": "^2.5.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
