# =============================================================================
# @gmrlog/backend — local overrides (optional)
# Root `.env` remains the primary example.
# =============================================================================

NODE_ENV=development
APP_ENV=development
LOG_LEVEL=info
APP_VERSION=0.0.0-dev

API_HOST=0.0.0.0
API_PORT=4000
API_GLOBAL_PREFIX=api/v1
API_DOCS_ENABLED=true
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql://gmrlog:gmrlog@localhost:5432/gmrlog?schema=public
REDIS_URL=redis://localhost:6379

# D1.4 auth foundation — dev default exists; production requires an explicit
# secret (min 32 chars, boot fails closed otherwise).
# JWT_SECRET=
JWT_ISSUER=gmrlog
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
