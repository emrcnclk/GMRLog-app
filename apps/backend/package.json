{
  "name": "@gmrlog/backend",
  "version": "0.0.0",
  "private": true,
  "description": "GMRLOG backend platform — NestJS + Fastify foundation (D1.2)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "worker": "node dist/worker.main.js",
    "worker:dev": "nest start --entryFile worker.main --watch",
    "repair:index": "node dist/repair-index.main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "node ../../node_modules/vitest/vitest.mjs run",
    "test:coverage": "node ../../node_modules/vitest/vitest.mjs run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1097.0",
    "@aws-sdk/s3-request-presigner": "^3.1097.0",
    "@fastify/compress": "^9.1.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/static": "^9.3.0",
    "@gmrlog/config": "workspace:*",
    "@gmrlog/database": "workspace:*",
    "@gmrlog/types": "workspace:*",
    "@gmrlog/validators": "workspace:*",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "^11.1.28",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/websockets": "^11.1.28",
    "@sentry/node": "^10.69.0",
    "bullmq": "^5.81.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "blurhash": "^2.0.5",
    "ioredis": "^5.11.1",
    "meilisearch": "^0.60.0",
    "nodemailer": "^9.0.3",
    "pino": "^10.3.1",
    "pino-roll": "^4.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@gmrlog/eslint-config": "workspace:*",
    "@gmrlog/typescript-config": "workspace:*",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.28",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^8.0.1",
    "@types/sharp": "^0.32.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^5.8.2",
    "vitest": "^4.1.10"
  }
}
