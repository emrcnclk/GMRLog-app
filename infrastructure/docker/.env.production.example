# =============================================================================
# GMRLOG backend — local production-parity example (D3.20)
# Copy to repo root `.env` or export before compose.
# All keys listed under PRODUCTION_REQUIRED_ENV_KEYS must be set explicitly.
# =============================================================================

NODE_ENV=production
APP_ENV=production
LOG_LEVEL=info

POSTGRES_USER=gmrlog
POSTGRES_PASSWORD=gmrlog
POSTGRES_DB=gmrlog
# Prefer 5433 on Windows hosts where a local Postgres already binds 5432
POSTGRES_PORT=5433

DATABASE_URL=postgresql://gmrlog:gmrlog@localhost:5433/gmrlog?schema=public&connection_limit=10&pool_timeout=10
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
CORS_ORIGINS=https://localhost

MINIO_ROOT_USER=gmrlog
MINIO_ROOT_PASSWORD=gmrlogsecret
S3_BUCKET=gmrlog
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=gmrlog
S3_SECRET_KEY=gmrlogsecret
S3_FORCE_PATH_STYLE=true
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/gmrlog/

MEILI_API_KEY=gmrlog-dev-master-key
MEILI_HOST=http://localhost:7700

# Required in production. With no key the backend refuses to boot rather than
# fall back to the mock Steam client, which would serve fixture libraries as
# though they were real player data. Get one at
# https://steamcommunity.com/dev/apikey
STEAM_WEB_API_KEY=

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@gmrlog.local
PASSWORD_RESET_URL_BASE=https://localhost/reset-password

METRICS_TOKEN=
SENTRY_DSN=
LOG_FILE=

HTTPS_PORT=443
HTTP_PORT=80
