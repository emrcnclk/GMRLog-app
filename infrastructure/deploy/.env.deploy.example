# =============================================================================
# GMRLOG — remote production stack template.
#
# This file is a TEMPLATE. Every secret in it is a placeholder, and
# `scripts/deploy/preflight-deploy-env.mjs` rejects those placeholders by value,
# so the stack will not start against this file as written.
#
# On the server:
#   node scripts/deploy/gen-secrets.mjs --domain api.gmrlog.com --email ops@gmrlog.com
#     writes infrastructure/deploy/.env.deploy.local with real random secrets,
#     leaving only the third-party keys below for you to paste in.
#
# The generated file is gitignored and must never be committed. Keep the
# authoritative copy in a password manager or a secrets manager; the file on the
# host is a cache of it, not the record.
# =============================================================================

# --- Identity -----------------------------------------------------------------
# The public hostname. Its DNS A/AAAA record must already point at this host
# before ./scripts/init-letsencrypt.sh runs.
API_DOMAIN=api.example.com
# Where Let's Encrypt sends expiry warnings. A real, monitored inbox.
LETSENCRYPT_EMAIL=ops@example.com
# 1 = issue from the Let's Encrypt staging CA (untrusted, unlimited). Use it for
# the first run on a new host, then set back to 0 and re-run init-letsencrypt.sh.
LETSENCRYPT_STAGING=0

# --- Image --------------------------------------------------------------------
# Set by CI when it deploys; deploy.sh overrides GMRLOG_IMAGE_TAG per release.
GMRLOG_IMAGE=ghcr.io/OWNER/REPO/backend
GMRLOG_IMAGE_TAG=latest

# --- Runtime ------------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=info
# Comma-separated. Every origin the browser app is served from. No trailing slash.
CORS_ORIGINS=https://app.example.com

# --- Postgres -----------------------------------------------------------------
POSTGRES_USER=gmrlog
# PLACEHOLDER — `openssl rand -base64 24`
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=gmrlog

# --- Secrets ------------------------------------------------------------------
# PLACEHOLDER — `openssl rand -base64 48`. Rotating this invalidates every
# issued access and refresh token, i.e. signs every user out.
JWT_SECRET=CHANGE_ME
# PLACEHOLDER — `openssl rand -base64 24`
MEILI_API_KEY=CHANGE_ME
# PLACEHOLDER — `openssl rand -base64 24`. Guards /api/v1/metrics; leave empty
# only if nothing scrapes it.
METRICS_TOKEN=CHANGE_ME

# --- Object storage (MinIO, fronted by nginx at https://$API_DOMAIN/media/) ----
MINIO_ROOT_USER=gmrlog
# PLACEHOLDER — `openssl rand -base64 24`
MINIO_ROOT_PASSWORD=CHANGE_ME
S3_BUCKET=gmrlog

# --- Mail ---------------------------------------------------------------------
# A real transactional provider. Mailpit is a development tool and is not part
# of this stack — with no working SMTP, password reset silently stops working.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
PASSWORD_RESET_URL_BASE=https://app.example.com/reset-password

# --- Third-party keys ---------------------------------------------------------
# Required: with no key the backend refuses to boot rather than fall back to the
# mock Steam client, which would serve fixture libraries as real player data.
# https://steamcommunity.com/dev/apikey
STEAM_WEB_API_KEY=
STEAM_OPENID_REALM=https://api.example.com
STEAM_OPENID_ALLOWED_RETURN_URIS=https://app.example.com/auth/steam/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Game catalog metadata. Unset leaves games at metadata_status = 'pending'.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# --- Observability ------------------------------------------------------------
# From the Sentry project's Client Keys (DSN) page. Empty disables Sentry
# entirely — main.ts only calls Sentry.init when this is non-empty.
SENTRY_DSN=
# Fraction of transactions traced. 0 = errors only. Start low; 0.1 on a busy API
# is a lot of events.
SENTRY_TRACES_SAMPLE_RATE=0

# --- Backups ------------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
# Offsite copy (optional but strongly recommended — a backup on the host it
# backs up survives a bad migration and nothing else). `mc`-style alias path.
BACKUP_S3_TARGET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
