# =============================================================================
# GMRLOG — Environment Variables (D1.2 backend foundation)
# Copy to `.env` for local development. Never commit real secrets.
# =============================================================================

# Shared / Runtime (MONOREPO_STRUCTURE)
NODE_ENV=development
APP_ENV=development
LOG_LEVEL=info
APP_VERSION=0.0.0-dev

# -----------------------------------------------------------------------------
# Backend platform (@gmrlog/backend)
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=4000
API_GLOBAL_PREFIX=api/v1
API_DOCS_ENABLED=true
CORS_ORIGINS=http://localhost:3000

# Prisma bootstrap (models arrive in D2)
DATABASE_URL=postgresql://gmrlog:gmrlog@localhost:5432/gmrlog?schema=public

# BullMQ bootstrap (queues arrive with domains)
REDIS_URL=redis://localhost:6379

# Authentication foundation (D1.4) — dev default exists; production requires
# an explicit secret (boot fails closed otherwise). Min 32 chars.
# JWT_SECRET=
JWT_ISSUER=gmrlog
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# -----------------------------------------------------------------------------
# Reserved for later D1 phases (storage / mail / frontend)
# Do not invent values here during foundation work.
# -----------------------------------------------------------------------------
# EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
# EXPO_PUBLIC_SOCKET_URL=http://localhost:4000
# EXPO_PUBLIC_APP_ENV=development

# -----------------------------------------------------------------------------
# Catalog mirror (D11.1-11.3)
# The game catalogue is mirrored from IGDB, not Steam — Steam is a per-player
# library source and a per-game enrichment provider, never a bulk catalogue.
# Without these two the mirror cannot authenticate and `catalog:sync` walks
# nothing. Credentials are Twitch application credentials:
# https://dev.twitch.tv/console/apps
# -----------------------------------------------------------------------------
# IGDB_CLIENT_ID=
# IGDB_CLIENT_SECRET=
# Requests per second against IGDB. Their documented ceiling is 4.
# IGDB_RATE_LIMIT_RPS=4
# Earliest release year the mirror walks. 0 walks everything IGDB has, back to
# the 1950s; 1990 is the default and the point where the catalogue starts being
# the one players have a history with.
# CATALOG_RELEASE_FLOOR_YEAR=1990
