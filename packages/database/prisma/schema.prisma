// GMRLOG — Persistence schema (D2.1).
//
// Single source of truth: S2 Database Specification (docs/17_.../S2_DATABASE_SPECIFICATION.md).
// Implements the S2 MVP entity catalog (§8/§10), relations (§11), constraints (§12),
// cascade policy (§13) and enum catalog (§14). No Version 2 / future-screen entities.
//
// Naming (S2 §3): PascalCase singular models mapped to snake_case plural tables;
// camelCase fields mapped to snake_case columns; enum members product-closed lowercase.
//
// Closed-set enums whose concrete members are NOT enumerated in S2/S1 (ReactionKind,
// NotificationKind, ReportReason, NotificationPreference.category, AdminActionRecord.action)
// are modelled as String. The database is the last line of integrity, not the only one
// (S2 §12) — the closed set is owned by product law + validators and is promoted to a
// Prisma enum once the members are specified. No members are invented here.
// Full audit: docs/07_DATABASE/S2_CLOSED_ENUM_GAP_REPORT.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS (S2 §14) — closed sets, additive growth only via Amendment.
// =============================================================================

enum AuthCredentialType {
  password
  oauth

  @@map("auth_credential_type")
}

/// D4.1 — login-capable identity providers (OAUTH.md §1). Google and Discord
/// issue a verifiable email and back an `auth_credentials` row; Steam does not
/// and stays connection-only, so it is deliberately not a member here — it
/// lives in `ConnectedProvider` / `AccountLinkProvider` instead.
enum OAuthProvider {
  google
  discord

  @@map("oauth_provider")
}

