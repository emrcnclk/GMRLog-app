// =============================================================================
// IDENTITY & SETTINGS (S2 §10.1)
// =============================================================================

model User {
  id              String    @id @default(cuid())
  handle          String    @unique
  displayName     String    @map("display_name")
  bio             String?
  avatarKey       String?   @map("avatar_key")
  bannerKey       String?   @map("banner_key")
  /// D3.26 — responsive media pipeline (docs/18_CATALOG/MEDIA_INGESTION.md).
  avatarBlurhash  String?   @map("avatar_blurhash")
  avatarVariants  Json?     @map("avatar_variants")
  bannerBlurhash  String?   @map("banner_blurhash")
  bannerVariants  Json?     @map("banner_variants")
  privacyId       String?   @map("privacy_id")
  /// D3.24 — Creator Profile surface flag (eligibility still deterministic).
  creatorFeatured Boolean   @default(false) @map("creator_featured")
  /// 5.4 — BACKEND_CHANGES.md §4. Gates the DNA match panel: `applicable: false`
  /// for any non-individual account. Every row backfills to `individual`.
  accountKind     AccountKind @default(individual) @map("account_kind")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  sessions                Session[]
  authCredentials         AuthCredential[]
  connectedAccounts       ConnectedAccount[]
  settings                UserSettings?
  notificationPreferences NotificationPreference[]
  libraryEntries          LibraryEntry[]
  posts                   Post[]
  reviews                 Review[]
  comments                Comment[]
  reactions               Reaction[]
  collections             Collection[]
  tierLists               TierList[]
  communityMemberships    CommunityMember[]
  eventParticipations     EventParticipation[]
  achievementProgress     AchievementProgress[]
  following               Follow[]                  @relation("UserFollowing")
  followers               Follow[]                  @relation("UserFollowers")
  blocksInitiated         Block[]                   @relation("UserBlocking")
  blocksReceived          Block[]                   @relation("UserBlocked")
  mutesInitiated          Mute[]                    @relation("UserMuting")
  mutesReceived           Mute[]                    @relation("UserMuted")
  friendRequestsSent      FriendRequest[]           @relation("FriendRequestsSent")
  friendRequestsReceived  FriendRequest[]           @relation("FriendRequestsReceived")
  friendshipsLow          Friendship[]              @relation("FriendshipUserLow")
  friendshipsHigh         Friendship[]              @relation("FriendshipUserHigh")
  presence                UserPresence?
  archetypes              UserArchetype[]
  profilePins             ProfilePin[]
  conversationParticipant ConversationParticipant[]
  messages                Message[]
  notifications           Notification[]
  activityItems           ActivityItem[]
  feedEntries             FeedEntry[]
  importJobs              ImportJob[]
  accountLinks            AccountLink[]
  uploads                 Upload[]
  reports                 Report[]
  moderationAssignments   ModerationCase[]
  adminActions            AdminActionRecord[]
  auditLogs               AuditLog[]
  collectionFollows       CollectionFollower[]
  userSimilaritiesLow     UserSimilarity[]          @relation("UserSimilarityLow")
  userSimilaritiesHigh    UserSimilarity[]          @relation("UserSimilarityHigh")
  integrations            UserIntegration[]
  externalProfiles        ExternalProfile[]
  syncJobs                SyncJob[]
  syncHistories           SyncHistory[]
  syncConflicts           SyncConflict[]
  /// D3.24
  postBookmarks           PostBookmark[]
  reposts                 Repost[]
  quotes                  Quote[]
  pollVotes               PollVote[]
  reputations             UserReputation[]
  eventInvitesSent        EventInvite[]             @relation("EventInvitesSent")
  eventInvitesReceived    EventInvite[]             @relation("EventInvitesReceived")
  wikiPagesEdited         CommunityWikiPage[]

  @@index([createdAt])
  @@map("users")
}

model Session {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuthCredential {
  id          String             @id @default(cuid())
  userId      String             @map("user_id")
  type        AuthCredentialType
  /// D4.1 — set only for `type=oauth`; which provider issued `providerRef`.
  /// Not part of the unique constraint below: it is NULL on every
  /// `type=password` row, and Postgres treats NULL as distinct in a unique
  /// index, so folding it into `@@unique` would stop enforcing one credential
  /// per e-mail for password sign-ups. Uniqueness for oauth rows is already
  /// covered by `providerRef` packing `'<provider>:<subject>'` (OAUTH.md §1,
  /// §0.1), which `type, providerRef` below continues to guarantee.
  provider    OAuthProvider?
  /// Email (password) or OAuth subject — lookup key, not a secret.
  providerRef String?            @map("provider_ref")
  /// Password hash for `type=password` only (scrypt). Never returned to clients.
  secretHash  String?            @map("secret_hash")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([type, providerRef])
  @@index([userId])
  @@map("auth_credentials")
}

model ConnectedAccount {
  id        String                 @id @default(cuid())
  userId    String                 @map("user_id")
  provider  ConnectedProvider
  status    ConnectedAccountStatus
  linkedAt  DateTime?              @map("linked_at")
  scopes    String[]
  createdAt DateTime               @default(now()) @map("created_at")
  updatedAt DateTime               @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("connected_accounts")
}

model UserSettings {
  id                String             @id @default(cuid())
  userId            String             @unique @map("user_id")
  locale            String?
  theme             ThemePreference?   @map("theme")
  reduceMotion      Boolean            @default(false) @map("reduce_motion")
  /// D3.29 — profile theme (docs/07_SOCIAL/PROFILE_CUSTOMIZATION.md "Backend
  /// follow-ups"). Public projection is gated by profileVisibility below.
  profileVisibility ContentVisibility  @default(public) @map("profile_visibility")
  accent            ProfileAccent      @default(neutral)
  cardStyle         ProfileCardStyle   @default(elevated) @map("card_style")
  bannerStyle       ProfileBannerStyle @default(artwork) @map("banner_style")
  favoritePlatform  String?            @map("favorite_platform")
  consoleGeneration ConsoleGeneration? @map("console_generation")
  /// Closed widget-id vocabulary owned by the client (PROFILE_CUSTOMIZATION.md);
  /// stored as text so a newly shipped widget never requires a migration.
  widgetOrder       String[]           @default([]) @map("widget_order")
  pinnedWidgets     String[]           @default([]) @map("pinned_widgets")
  hiddenWidgets     String[]           @default([]) @map("hidden_widgets")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model NotificationPreference {
  id        String              @id @default(cuid())
  userId    String              @map("user_id")
  channel   NotificationChannel
  // Closed set not enumerated in S2/§14 — product-governed, promoted to enum on spec.
  category  String
  enabled   Boolean             @default(true)
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, category])
  @@index([userId])
  @@map("notification_preferences")
}

// =============================================================================
// CATALOG & GAMES (S2 §10.2) — reference data, catalog-managed (no player soft delete).
// =============================================================================

model Game {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  coverKey    String?   @map("cover_key")
  releaseDate DateTime? @map("release_date")
  featured    Boolean   @default(false)
  popularity  Int       @default(0)
  franchiseId String?   @map("franchise_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  /// D3.25 — external catalog identity (docs/18_CATALOG/GAME_METADATA_ARCHITECTURE.md §3.1).
  igdbId     Int? @unique @map("igdb_id")
  steamAppId Int? @unique @map("steam_app_id")
  rawgId     Int? @unique @map("rawg_id")

  /// D3.25 — descriptive metadata.
  summary             String? @db.Text
  description         String? @db.Text
  heroKey             String? @map("hero_key")
  trailerUrl          String? @map("trailer_url")
  externalRating      Float?  @map("external_rating")
  externalRatingCount Int?    @map("external_rating_count")
  seriesId            String? @map("series_id")

  /// D3.25 — enrichment lifecycle.
  metadataStatus      GameMetadataStatus @default(pending) @map("metadata_status")
  metadataProvider    MetadataProvider?  @map("metadata_provider")
  metadataConfidence  Float?             @map("metadata_confidence")
  metadataVersion     Int                @default(0) @map("metadata_version")
  metadataRefreshedAt DateTime?          @map("metadata_refreshed_at")
  metadataAttempts    Int                @default(0) @map("metadata_attempts")
  metadataError       String?            @map("metadata_error")

  /// D3.26 — responsive media pipeline (docs/18_CATALOG/MEDIA_INGESTION.md).
  coverBlurhash String? @map("cover_blurhash")
  coverVariants Json?   @map("cover_variants")
  heroBlurhash  String? @map("hero_blurhash")
  heroVariants  Json?   @map("hero_variants")

  franchise             Franchise?           @relation(fields: [franchiseId], references: [id], onDelete: SetNull)
  series                GameSeries?          @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  media                 GameMedia[]
  platforms             GamePlatform[]
  genres                GameGenre[]
  tags                  GameTag[]
  companies             GameCompany[]
  relatedGames          GameRelatedGame[]    @relation("GameRelatedSource")
  relatedToGames        GameRelatedGame[]    @relation("GameRelatedTarget")
  metadataRuns          GameMetadataRun[]
  libraryEntries        LibraryEntry[]
  reviews               Review[]
  posts                 Post[]
  collectionEntries     CollectionEntry[]
  tierSlotGames         TierSlotGame[]
  events                Event[]
  importItems           ImportItem[]
  discoveryScore        DiscoveryScore?
  gameSimilaritiesAsA   GameSimilarity[]     @relation("GameSimilarityA")
  gameSimilaritiesAsB   GameSimilarity[]     @relation("GameSimilarityB")
  recommendationSeeds   RecommendationRule[] @relation("RecommendationSeed")
  recommendationTargets RecommendationRule[] @relation("RecommendationTarget")
  externalGames         ExternalGame[]

  @@index([title])
  @@index([featured, popularity, releaseDate])
  @@index([franchiseId])
  /// D3.25 — backfill / refresh scan selection.
  @@index([metadataStatus, metadataAttempts])
  @@index([metadataRefreshedAt])
  @@index([seriesId])
  @@map("games")
}

/// D3.25 — provider "collection"/series grouping, distinct from Franchise.
model GameSeries {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  games Game[]

  @@map("game_series")
}

/// D3.25 — theme / mode / perspective / keyword taxonomy.
model Tag {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  kind      TagKind  @default(keyword)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  games GameTag[]

  @@index([kind])
  @@map("tags")
}

model GameTag {
  id        String   @id @default(cuid())
  gameId    String   @map("game_id")
  tagId     String   @map("tag_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([gameId, tagId])
  @@index([tagId])
  @@map("game_tags")
}

/// D3.25 — developers and publishers.
model Company {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  games GameCompany[]

  @@map("companies")
}

model GameCompany {
  id        String      @id @default(cuid())
  gameId    String      @map("game_id")
  companyId String      @map("company_id")
  role      CompanyRole
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  game    Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([gameId, companyId, role])
  @@index([companyId, role])
  @@map("game_companies")
}

/// D3.25 — provider-declared game relationships. `relatedGameId` stays null
/// until the referenced external id exists in our catalog.
model GameRelatedGame {
  id                String           @id @default(cuid())
  gameId            String           @map("game_id")
  relatedGameId     String?          @map("related_game_id")
  provider          MetadataProvider
  relatedExternalId String           @map("related_external_id")
  relatedTitle      String?          @map("related_title")
  kind              GameRelatedKind  @default(similar)
  sortOrder         Int              @default(0) @map("sort_order")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  game        Game  @relation("GameRelatedSource", fields: [gameId], references: [id], onDelete: Cascade)
  relatedGame Game? @relation("GameRelatedTarget", fields: [relatedGameId], references: [id], onDelete: SetNull)

  @@unique([gameId, provider, relatedExternalId, kind])
  @@index([gameId, kind, sortOrder])
  @@index([relatedGameId])
  @@map("game_related_games")
}

/// D3.25 — one row per enrichment attempt. Observability + coverage reporting.
model GameMetadataRun {
  id            String             @id @default(cuid())
  gameId        String             @map("game_id")
  provider      MetadataProvider?
  outcome       MetadataRunOutcome
  reason        String
  confidence    Float?
  fieldsWritten Int                @default(0) @map("fields_written")
  mediaQueued   Int                @default(0) @map("media_queued")
  durationMs    Int                @default(0) @map("duration_ms")
  error         String?
  createdAt     DateTime           @default(now()) @map("created_at")

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, createdAt])
  @@index([outcome, createdAt])
  @@map("game_metadata_runs")
}

model Genre {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  games GameGenre[]

  @@map("genres")
}

model Platform {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  gamePlatforms  GamePlatform[]
  libraryEntries LibraryEntry[]

  @@map("platforms")
}

model Franchise {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  games Game[]

  @@map("franchises")
}

model GameGenre {
  id        String   @id @default(cuid())
  gameId    String   @map("game_id")
  genreId   String   @map("genre_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  game  Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@unique([gameId, genreId])
  @@index([genreId])
  @@map("game_genres")
}

model GameMedia {
  id         String        @id @default(cuid())
  gameId     String        @map("game_id")
  kind       GameMediaKind
  storageKey String        @map("storage_key")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  /// D3.25 — ingestion provenance (docs/18_CATALOG/MEDIA_INGESTION.md).
  provider  MetadataProvider?
  sourceUrl String?           @map("source_url")
  sortOrder Int               @default(0) @map("sort_order")
  width     Int?
  height    Int?

  /// D3.26 — responsive media pipeline (docs/18_CATALOG/MEDIA_INGESTION.md).
  blurhash String? @map("blurhash")
  variants Json?   @map("variants")

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, kind, sourceUrl])
  @@index([gameId])
  @@index([gameId, kind, sortOrder])
  @@index([provider])
  @@map("game_media")
}

model GamePlatform {
  id         String   @id @default(cuid())
  gameId     String   @map("game_id")
  platformId String   @map("platform_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  game     Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  platform Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@unique([gameId, platformId])
  @@index([platformId])
  @@map("game_platforms")
}

// =============================================================================
// LIBRARY (S2 §10.3)
// =============================================================================

model LibraryEntry {
  id         String        @id @default(cuid())
  userId     String        @map("user_id")
  gameId     String        @map("game_id")
  status     LibraryStatus
  source     LibrarySource
  platformId String?       @map("platform_id")
  note       String?
  version    Int           @default(0)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [id])
  game             Game              @relation(fields: [gameId], references: [id])
  platform         Platform?         @relation(fields: [platformId], references: [id], onDelete: SetNull)
  logs             GameLog[]
  wishlistMetadata WishlistMetadata?

  @@unique([userId, gameId])
  @@index([gameId])
  @@index([userId, status])
  @@map("library_entries")
}

model GameLog {
  id             String      @id @default(cuid())
  libraryEntryId String      @map("library_entry_id")
  kind           GameLogKind
  occurredAt     DateTime    @map("occurred_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  libraryEntry LibraryEntry @relation(fields: [libraryEntryId], references: [id], onDelete: Cascade)

  @@index([libraryEntryId])
  @@map("game_logs")
}

// =============================================================================
// CONTENT (S2 §10.4)
// =============================================================================

model Post {
  id               String            @id @default(cuid())
  authorId         String            @map("author_id")
  gameId           String?           @map("game_id")
  communityId      String?           @map("community_id")
  body             String
  visibility       ContentVisibility
  /// D3.24
  postKind         PostKind          @default(text) @map("post_kind")
  containsSpoilers Boolean           @default(false) @map("contains_spoilers")
  pinnedAt         DateTime?         @map("pinned_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  deletedAt        DateTime?         @map("deleted_at")

  author    User           @relation(fields: [authorId], references: [id])
  game      Game?          @relation(fields: [gameId], references: [id], onDelete: SetNull)
  community Community?     @relation(fields: [communityId], references: [id], onDelete: SetNull)
  media     PostMedia[]
  bookmarks PostBookmark[]
  reposts   Repost[]
  poll      Poll?

  @@index([authorId, createdAt])
  @@index([gameId])
  @@index([communityId])
  @@index([authorId, pinnedAt])
  @@map("posts")
}

/// D3.24 — Platform storage refs only (bytes owned by Platform).
model PostMedia {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  uploadKey String   @map("upload_key")
  kind      String   @default("image")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// D3.26 — responsive media pipeline (docs/18_CATALOG/MEDIA_INGESTION.md).
  blurhash String? @map("blurhash")
  variants Json?   @map("variants")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, position])
  @@map("post_media")
}

/// D3.24 — private bookmarks.
model PostBookmark {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  postId    String   @map("post_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId, createdAt])
  @@map("post_bookmarks")
}

/// D3.24 — amplify without body.
model Repost {
  id             String    @id @default(cuid())
  actorId        String    @map("actor_id")
  originalPostId String    @map("original_post_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  actor        User @relation(fields: [actorId], references: [id], onDelete: Cascade)
  originalPost Post @relation(fields: [originalPostId], references: [id], onDelete: Cascade)

  @@unique([actorId, originalPostId])
  @@index([originalPostId])
  @@map("reposts")
}

/// D3.24 Quote System v2 — multi-target.
model Quote {
  id         String            @id @default(cuid())
  authorId   String            @map("author_id")
  targetType QuoteTargetType   @map("target_type")
  targetId   String            @map("target_id")
  body       String
  visibility ContentVisibility @default(public)
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")
  deletedAt  DateTime?         @map("deleted_at")

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId, createdAt])
  @@index([targetType, targetId])
  @@map("quotes")
}

/// D3.24 polls attached to posts.
model Poll {
  id        String    @id @default(cuid())
  postId    String    @unique @map("post_id")
  question  String
  options   String[]
  endsAt    DateTime? @map("ends_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  post  Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@map("polls")
}

model PollVote {
  id          String   @id @default(cuid())
  pollId      String   @map("poll_id")
  userId      String   @map("user_id")
  optionIndex Int      @map("option_index")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([userId])
  @@map("poll_votes")
}

model Review {
  id               String            @id @default(cuid())
  authorId         String            @map("author_id")
  gameId           String            @map("game_id")
  rating           Int
  body             String?
  containsSpoilers Boolean           @default(false) @map("contains_spoilers")
  visibility       ContentVisibility
  version          Int               @default(0)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  deletedAt        DateTime?         @map("deleted_at")

  author User @relation(fields: [authorId], references: [id])
  game   Game @relation(fields: [gameId], references: [id])

  @@index([authorId, createdAt])
  @@index([gameId, createdAt])
  @@map("reviews")
}

// Comment host is polymorphic (hostType/hostId) — no cross-type FK by design (S2 §10.4).
model Comment {
  id              String          @id @default(cuid())
  authorId        String          @map("author_id")
  hostType        CommentHostType @map("host_type")
  hostId          String          @map("host_id")
  parentCommentId String?         @map("parent_comment_id")
  body            String
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")

  author  User      @relation(fields: [authorId], references: [id])
  parent  Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: SetNull)
  replies Comment[] @relation("CommentReplies")

  @@index([hostType, hostId, createdAt])
  @@index([authorId])
  @@index([parentCommentId])
  @@map("comments")
}

// Reaction target is polymorphic (targetType/targetId) — no cross-type FK by design.
model Reaction {
  id         String             @id @default(cuid())
  actorId    String             @map("actor_id")
  targetType ReactionTargetType @map("target_type")
  targetId   String             @map("target_id")
  // Closed reaction set not enumerated in S2/§14 — product-governed, promoted to enum on spec.
  kind       String
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@unique([actorId, targetType, targetId, kind])
  @@index([targetType, targetId])
  @@map("reactions")
}

// =============================================================================
// CURATION (S2 §10.5)
// =============================================================================

model Collection {
  id          String            @id @default(cuid())
  ownerId     String            @map("owner_id")
  title       String
  description String?
  visibility  ContentVisibility
  /// D3.22 — docs/09_DISCOVERY/COLLECTION_TYPES.md
  type        CollectionType    @default(manual)
  /// Dynamic rule catalog key when type=dynamic.
  ruleKey     String?           @map("rule_key")
  bannerKey   String?           @map("banner_key")
  coverKey    String?           @map("cover_key")
  color       String?
  tags        String[]          @default([])
  version     Int               @default(0)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  deletedAt   DateTime?         @map("deleted_at")

  owner     User                 @relation(fields: [ownerId], references: [id])
  entries   CollectionEntry[]
  followers CollectionFollower[]

  @@index([ownerId])
  @@index([type])
  @@map("collections")
}

model CollectionEntry {
  id           String   @id @default(cuid())
  collectionId String   @map("collection_id")
  gameId       String   @map("game_id")
  position     Int
  note         String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  game       Game       @relation(fields: [gameId], references: [id])

  @@unique([collectionId, gameId])
  @@index([collectionId, position])
  @@map("collection_entries")
}

model TierList {
  id         String            @id @default(cuid())
  ownerId    String            @map("owner_id")
  title      String
  visibility ContentVisibility
  version    Int               @default(0)
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")
  deletedAt  DateTime?         @map("deleted_at")

  owner User       @relation(fields: [ownerId], references: [id])
  slots TierSlot[]

  @@index([ownerId])
  @@map("tier_lists")
}

model TierSlot {
  id         String   @id @default(cuid())
  tierListId String   @map("tier_list_id")
  label      String
  position   Int
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tierList TierList       @relation(fields: [tierListId], references: [id], onDelete: Cascade)
  games    TierSlotGame[]

  @@index([tierListId, position])
  @@map("tier_slots")
}

model TierSlotGame {
  id         String   @id @default(cuid())
  tierSlotId String   @map("tier_slot_id")
  gameId     String   @map("game_id")
  position   Int
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tierSlot TierSlot @relation(fields: [tierSlotId], references: [id], onDelete: Cascade)
  game     Game     @relation(fields: [gameId], references: [id])

  @@unique([tierSlotId, gameId])
  @@index([tierSlotId, position])
  @@map("tier_slot_games")
}

// =============================================================================
// COMMUNITIES & EVENTS (S2 §10.6)
// =============================================================================

model Community {
  id             String            @id @default(cuid())
  name           String
  slug           String            @unique
  description    String?
  visibility     ContentVisibility @default(public)
  /// D3.24
  joinType       CommunityJoinType @default(public) @map("join_type")
  /// 3b.1e — required, single-valued, BACKEND_CHANGES.md §6. Existing rows backfilled to 'games'.
  kind           CommunityKind     @default(games)
  tags           String[]          @default([])
  avatarKey      String?           @map("avatar_key")
  bannerKey      String?           @map("banner_key")
  /// D3.26 — responsive media pipeline (docs/18_CATALOG/MEDIA_INGESTION.md).
  avatarBlurhash String?           @map("avatar_blurhash")
  avatarVariants Json?             @map("avatar_variants")
  bannerBlurhash String?           @map("banner_blurhash")
  bannerVariants Json?             @map("banner_variants")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  deletedAt      DateTime?         @map("deleted_at")

  members    CommunityMember[]
  activities CommunityActivity[]
  events     Event[]
  posts      Post[]
  wikiPages  CommunityWikiPage[]
  pins       CommunityPin[]
  badges     CommunityMemberBadge[]

  @@map("communities")
}

model CommunityMember {
  id          String        @id @default(cuid())
  communityId String        @map("community_id")
  userId      String        @map("user_id")
  role        CommunityRole
  joinedAt    DateTime      @default(now()) @map("joined_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  community Community              @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  badges    CommunityMemberBadge[]

  @@unique([communityId, userId])
  @@index([userId])
  @@map("community_members")
}

/// D3.24 community flair (Founder · Moderator · Top Contributor · Verified Creator).
model CommunityMemberBadge {
  id          String             @id @default(cuid())
  memberId    String             @map("member_id")
  communityId String             @map("community_id")
  kind        CommunityBadgeKind
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  member    CommunityMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  community Community       @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([memberId, kind])
  @@index([communityId])
  @@map("community_member_badges")
}

/// D3.24 community wiki pages.
model CommunityWikiPage {
  id          String   @id @default(cuid())
  communityId String   @map("community_id")
  slug        String
  title       String
  body        String
  updatedById String   @map("updated_by_id")
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  updatedBy User      @relation(fields: [updatedById], references: [id])

  @@unique([communityId, slug])
  @@index([communityId])
  @@map("community_wiki_pages")
}

/// D3.24 community-scoped pins.
model CommunityPin {
  id          String   @id @default(cuid())
  communityId String   @map("community_id")
  objectType  String   @map("object_type")
  objectId    String   @map("object_id")
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([communityId, objectType, objectId])
  @@index([communityId, position])
  @@map("community_pins")
}

model CommunityActivity {
  id             String   @id @default(cuid())
  communityId    String   @map("community_id")
  activityItemId String   @map("activity_item_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  community    Community    @relation(fields: [communityId], references: [id], onDelete: Cascade)
  activityItem ActivityItem @relation(fields: [activityItemId], references: [id], onDelete: Cascade)

  @@index([communityId])
  @@index([activityItemId])
  @@map("community_activities")
}

model Event {
  id          String    @id @default(cuid())
  title       String
  kind        EventKind
  description String?
  startsAt    DateTime  @map("starts_at")
  endsAt      DateTime? @map("ends_at")
  gameId      String?   @map("game_id")
  communityId String?   @map("community_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  game           Game?                @relation(fields: [gameId], references: [id], onDelete: SetNull)
  community      Community?           @relation(fields: [communityId], references: [id], onDelete: SetNull)
  participations EventParticipation[]
  invites        EventInvite[]

  @@index([gameId])
  @@index([communityId])
  @@index([startsAt])
  @@map("events")
}

model EventParticipation {
  id        String                  @id @default(cuid())
  eventId   String                  @map("event_id")
  userId    String                  @map("user_id")
  state     EventParticipationState
  createdAt DateTime                @default(now()) @map("created_at")
  updatedAt DateTime                @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_participations")
}

/// D3.24 — invite friends to event.
model EventInvite {
  id        String   @id @default(cuid())
  eventId   String   @map("event_id")
  inviterId String   @map("inviter_id")
  inviteeId String   @map("invitee_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  inviter User  @relation("EventInvitesSent", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee User  @relation("EventInvitesReceived", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@unique([eventId, inviteeId])
  @@index([inviteeId])
  @@map("event_invites")
}

// =============================================================================
// ACHIEVEMENTS (S2 §10.7) — GMRLOG-owned achievements only (never Steam).
// =============================================================================

model Achievement {
  id          String   @id @default(cuid())
  key         String   @unique
  title       String
  description String
  criteriaRef String   @map("criteria_ref")
  /// D3.21 category taxonomy (docs/07_SOCIAL/ACHIEVEMENT_SYSTEM.md).
  category    String   @default("milestones")
  isHidden    Boolean  @default(false) @map("is_hidden")
  isRare      Boolean  @default(false) @map("is_rare")
  target      Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  progress             AchievementProgress[]
  externalAchievements ExternalAchievement[]

  @@index([category])
  @@map("achievements")
}

