  warningCount  Int                 @default(0) @map("warning_count")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  integration UserIntegration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  syncJob     SyncJob          @relation(fields: [syncJobId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@map("sync_history")
}

model SyncConflict {
  id             String                  @id @default(cuid())
  userId         String                  @map("user_id")
  integrationId  String?                 @map("integration_id")
  syncJobId      String?                 @map("sync_job_id")
  externalGameId String?                 @map("external_game_id")
  internalGameId String?                 @map("internal_game_id")
  kind           String                  @default("conflict")
  resolution     SyncConflictResolution?
  resolvedAt     DateTime?               @map("resolved_at")
  localSnapshot  Json?                   @map("local_snapshot")
  remoteSnapshot Json?                   @map("remote_snapshot")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  integration UserIntegration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  syncJob     SyncJob?         @relation(fields: [syncJobId], references: [id], onDelete: SetNull)

  @@index([userId, resolvedAt])
  @@index([syncJobId])
  @@map("sync_conflicts")
}
