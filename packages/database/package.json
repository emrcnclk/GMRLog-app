{
  "name": "@gmrlog/database",
  "version": "0.0.0",
  "private": true,
  "description": "GMRLOG persistence foundation — Prisma schema, migrations and repositories (D2.1)",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "prisma generate",
    "build": "pnpm generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "prisma generate && node ../../node_modules/vitest/vitest.mjs run",
    "test:pg": "node scripts/validate-postgres.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@gmrlog/eslint-config": "workspace:*",
    "@gmrlog/typescript-config": "workspace:*",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.15.0",
    "embedded-postgres": "17.10.0-beta.17",
    "pg": "^8.16.0",
    "pglite-prisma-adapter": "0.6.1",
    "prisma": "^6.5.0",
    "typescript": "^5.8.2",
    "vitest": "^4.1.10"
  }
}
