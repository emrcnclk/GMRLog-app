{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@gmrlog/frontend", "run", "web"],
      "port": 8081
    },
    {
      "name": "frontend-web-clear",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@gmrlog/frontend",
        "exec",
        "expo",
        "start",
        "--web",
        "--clear",
        "--port",
        "8081"
      ],
      "port": 8081
    }
  ]
}
